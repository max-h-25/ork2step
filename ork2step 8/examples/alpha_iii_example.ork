<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<openrocket version="1.7" creator="OpenRocket 15.03">
  <rocket>
    <name>Estes Alpha III Example</name>
    <designer>Test Designer</designer>
    <comment>Minimal example for ork2step testing</comment>

    <subcomponents>
      <stage>
        <name>Sustainer</name>
        <subcomponents>

          <!-- Nose cone -->
          <nosecone>
            <name>Nose Cone</name>
            <finish>normal</finish>
            <material type="bulk" density="680.0">Balsa wood</material>
            <length>0.07</length>
            <thickness>0.0032</thickness>
            <shape>ogive</shape>
            <aftradius>0.0155</aftradius>
            <aftshoulderradius>0.01488</aftshoulderradius>
            <aftshoulderlength>0.025</aftshoulderlength>
            <aftshoulderthickness>0.0016</aftshoulderthickness>
            <aftshouldercapped>false</aftshouldercapped>
            <subcomponents/>
          </nosecone>

          <!-- Main body tube -->
          <bodytube>
            <name>Body Tube</name>
            <finish>normal</finish>
            <material type="bulk" density="680.0">Balsa wood</material>
            <length>0.254</length>
            <thickness>0.0016</thickness>
            <radius>0.0155</radius>

            <subcomponents>

              <!-- Fin set -->
              <trapezoidfinset>
                <name>Fins</name>
                <finish>normal</finish>
                <material type="bulk" density="680.0">Balsa wood</material>
                <fincount>3</fincount>
                <rotation>0.0</rotation>
                <thickness>0.0032</thickness>
                <crosssection>square</crosssection>
                <cant>0.0</cant>
                <rootchord>0.0635</rootchord>
                <tipchord>0.0318</tipchord>
                <height>0.0508</height>
                <sweeplength>0.0127</sweeplength>
                <subcomponents/>
              </trapezoidfinset>

              <!-- Motor mount -->
              <innertube>
                <name>Motor Mount</name>
                <material type="bulk" density="1424.0">Paper phenolic</material>
                <length>0.07</length>
                <thickness>0.0016</thickness>
                <radius>0.009</radius>
                <subcomponents/>
              </innertube>

            </subcomponents>
          </bodytube>

        </subcomponents>
      </stage>
    </subcomponents>

  </rocket>
</openrocket>
